{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types"
    ]
  },
  "include": [
    "wdio.conf.ts",
    "test/**/*.ts"
  ]
}
