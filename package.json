{
  "name": "relx-web-api-automation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node scripts/run-tests.cjs all",
    "test:api": "node scripts/run-tests.cjs api",
    "test:web": "node scripts/run-tests.cjs web",
    "test:api:run": "mocha --timeout 30000 --reporter allure-mocha --reporter-option resultsDir=./test_reports/allure-results \"test/specs/api/**/*.api.js\"",
    "test:web:run": "wdio run ./wdio.conf.js",
    "report:open": "allure open ./test_reports/allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "allure-commandline": "^2.46.1",
    "allure-mocha": "^3.14.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "mocha": "^11.1.0"
  }
}
